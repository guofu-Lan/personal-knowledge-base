  "narrative": {
    "northStar": "The Language Machine Workshop",
    "overview": "This visual system makes learning feel like operating a friendly exhibit: a learner turns a lever, watches a small idea move through observation and thought, and tries a piece of language themselves. Rounded mechanical forms, enamel-like colors, and crisp work surfaces keep that process tangible without borrowing textbook artwork.\n\nThe interface stays bright and calm enough for reading in a home or classroom, while the cobalt machine, moving gears, and vermilion controls make interaction easy to spot. Chinese system-font fallbacks keep the lesson text dependable across common devices.",
    "keyCharacteristics": [
      "Language learning is shown as a visible, manipulable mechanism.",
      "Cobalt carries primary actions; warm signal colors mark distinct activity parts.",
      "Lesson text remains on clear, high-contrast surfaces.",
      "Responsive layouts preserve the machine and move the lesson beneath it on narrow screens."
    ],
    "rules": [
      {
        "name": "The Enamel Signal Rule",
        "body": "Use vivid red, yellow, and mint as deliberate mechanism cues, not as body-copy colors or blanket decoration.",
        "section": "colors"
      },
      {
        "name": "The Read-It-First Rule",
        "body": "Keep Chinese body text on a quiet, high-contrast surface; reserve saturated color for controls and the mechanical illustration.",
        "section": "typography"
      },
      {
        "name": "The One-Lift Rule",
        "body": "Keep ordinary lesson, unit, practice, and daily-task surfaces flat; reserve the raised shadow for the principal workbench.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep Chinese explanations on uncluttered light surfaces and use concise, concrete examples.",
      "Do make the current unit, micro-lesson, and learning stage easy to identify.",
      "Do keep the Hunan school context separate from the unified textbook edition label.",
      "Do label temporary school notices with their specific date and one-time status.",
      "Do use original inline artwork and motion for lessons without verified video permissions."
    ],
    "donts": [
      "Don't use textbook passages, third-party lesson plans, illustrations, or video in the sample.",
      "Don't present the one-time November 16, 2026 research schedule as a recurring timetable.",
      "Don't assign saturated accent colors to long Chinese paragraphs.",
      "Don't add unrelated shadows or turn every content group into an individual card."
    ]
  }
}
